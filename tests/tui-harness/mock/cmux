#!/usr/bin/env bash
# mux.sh 回帰検証用の cmux モック（surface p1 のみ）。画面は $MOCK_DIR/screen、送信キーは $MOCK_DIR/keys に記録する。
D=$MOCK_DIR
case "$1" in
  ping) exit 0 ;;
  workspace) echo '{"workspaces":[{"id":"ws1","title":"mock"}]}' ;;
  rpc) echo '{"surfaces":[{"id":"p1","ref":"surface:1","title":"","focused":false}]}' ;;
  top) : ;;
  read-screen) # --lines <N> の指定どおり末尾 N 行だけ返す
    n=$(printf '%s\n' "$@" | grep -A1 -x -- --lines | tail -n1); tail -n "${n:-20}" "$D/screen" ;;
  send) # send [--paste] --surface p1 <テキスト>（テキストは最後の引数）
    [ "${MOCK_MODE:-}" = drop ] || python3 "$(dirname "$0")/render.py" "$D/screen" "${@: -1}" ;;
  send-key) echo "$4" >> "$D/keys"; echo "● working" >> "$D/screen" ;;
  *) echo "cmux モック: 未対応 $*" >&2; exit 9 ;;
esac
